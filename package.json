{
  "name": "domo-website",
  "version": "1.0.0",
  "private": true,
  "description": "Domo housing website with responsive pages, scroll animations, local media, and enquiry forms",
  "license": "MIT",
  "keywords": [
    "domo",
    "housing",
    "nextjs",
    "website"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:navigation": "node scripts/verify-navigation.mjs",
    "test:enquiries": "node --experimental-strip-types --test tests/enquiries.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:enquiries && npm run build"
  },
  "dependencies": {
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "typescript": "^5"
  }
}
